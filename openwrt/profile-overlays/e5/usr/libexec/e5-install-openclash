#!/bin/sh
# Install the official APK on the target, where apk can resolve dependencies
# against the target's OpenWrt 25.12 package database.
set -u
PKG=/etc/e5/packages/luci-app-openclash.apk
LOG=/tmp/e5-openclash-install.log
[ -f "$PKG" ] || exit 0

if [ -f /etc/e5/openclash-manifest.json ] && command -v sha256sum >/dev/null 2>&1; then
	want=$(sed -n 's/.*"apk_sha256"[[:space:]]*:[[:space:]]*"\([0-9a-f]*\)".*/\1/p' /etc/e5/openclash-manifest.json)
	[ -z "$want" ] || [ "$(sha256sum "$PKG" | awk '{print $1}')" = "$want" ] || {
		echo 'OpenClash APK checksum mismatch' >>"$LOG"
		exit 1
	}
fi

if [ -x /etc/init.d/openclash ] && [ -f /etc/config/openclash ]; then
	touch /etc/e5/openclash-installed
	exit 0
fi

command -v apk >/dev/null 2>&1 || exit 1
apk update >>"$LOG" 2>&1 || true
apk add --allow-untrusted "$PKG" >>"$LOG" 2>&1 || exit 1
chmod 755 /etc/init.d/openclash 2>/dev/null || true
[ -x /etc/openclash/core/clash_meta ] && chmod 755 /etc/openclash/core/clash_meta
rm -rf /tmp/luci-indexcache /tmp/luci-indexcache.* \
	/tmp/luci-modulecache /tmp/luci-modulecache.* 2>/dev/null || true
touch /etc/e5/openclash-installed
exit 0
